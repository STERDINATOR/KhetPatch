APP_ENV="development"
APP_NAME="KhetPatch"
APP_URL="MY_APP_URL"

# Server-side AI (Gemini)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-4-hydrogen"

# Google Maps Platform (Client-side Maps JavaScript API)
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# NASA Earthdata (Required for authenticated GPM/SMAP/Landsat raster subsetting; NASA POWER & CMR discovery work without token)
EARTHDATA_TOKEN=""
NASA_POWER_BASE_URL="https://power.larc.nasa.gov/api"

# Optional Public Showcase Location (When enabled=true, loads explicitly labeled showcase location on /)
PUBLIC_SHOWCASE_LOCATION_ENABLED="false"
PUBLIC_SHOWCASE_LATITUDE=""
PUBLIC_SHOWCASE_LONGITUDE=""
PUBLIC_SHOWCASE_LABEL=""

# Weather & Market Providers (Optional external API credentials)
IMD_API_KEY=""
DATA_GOV_API_KEY=""

# Demo Authentication (Automatically disabled when APP_ENV=production)
DEMO_AUTH_ENABLED="true"
DEMO_ACCOUNT_EMAIL="user@khetpatch.org"
DEMO_ACCOUNT_PASSWORD="User123"

# Optional Managed Postgres / Supabase Deployment
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
DATABASE_URL=""
CRON_SECRET=""
